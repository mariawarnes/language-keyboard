<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_background"
    android:orientation="vertical">

    <!-- The "practice window": shows what you typed in the language you're learning. -->
    <LinearLayout
        android:id="@+id/strip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/strip_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/language_chip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/strip_chip"
            android:contentDescription="@string/cd_toggle_translation"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/strip_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/typed_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/strip_text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/translating_indicator"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="…"
            android:textColor="@color/strip_text_secondary"
            android:textSize="17sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/clear_button"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_clear"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/strip_text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/settings_button"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/strip_text_secondary"
            android:textSize="20sp" />
    </LinearLayout>

    <io.github.mariawarnes.languagekeyboard.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
