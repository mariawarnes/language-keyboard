<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_background"
    android:orientation="vertical">

    <!-- The "practice window": shows what you typed in the language you're learning. -->
    <LinearLayout
        android:id="@+id/strip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/strip_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <!-- Which language you're typing in: the language you're learning (practice mode) or
             your own (direct mode). The highlighted half is the current one; tap either half. -->
        <LinearLayout
            android:id="@+id/language_toggle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/toggle_learning"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/toggle_native"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scrolls sideways to follow the cursor (slide on the space bar, or tap the text). -->
        <HorizontalScrollView
            android:id="@+id/practice_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <io.github.mariawarnes.languagekeyboard.PracticeTextView
                android:id="@+id/typed_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/strip_text"
                android:textSize="17sp" />
        </HorizontalScrollView>


        <TextView
            android:id="@+id/translating_indicator"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="…"
            android:textColor="@color/strip_text_secondary"
            android:textSize="17sp"
            android:visibility="invisible" />

        <!-- Only shown when there's practice text to clear. -->
        <ImageView
            android:id="@+id/clear_button"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_clear"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="@color/strip_text_secondary"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/settings_button"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:tint="@color/strip_text_secondary" />
    </LinearLayout>

    <!-- Explains a marked mistake in the practice text and offers fixes. -->
    <LinearLayout
        android:id="@+id/correction_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/strip_background"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/correction_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="3"
            android:textColor="@color/strip_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/correction_fix_1"
            style="@style/CorrectionChip" />

        <TextView
            android:id="@+id/correction_fix_2"
            style="@style/CorrectionChip" />

        <ImageView
            android:id="@+id/correction_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="@color/strip_text_secondary" />
    </LinearLayout>

    <!-- Word suggestions / autocorrect / gesture alternatives. -->
    <LinearLayout
        android:id="@+id/suggestions"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/suggestion_left"
            style="@style/SuggestionSlot" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/kb_key_function" />

        <TextView
            android:id="@+id/suggestion_center"
            style="@style/SuggestionSlot" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/kb_key_function" />

        <TextView
            android:id="@+id/suggestion_right"
            style="@style/SuggestionSlot" />
    </LinearLayout>

    <io.github.mariawarnes.languagekeyboard.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
